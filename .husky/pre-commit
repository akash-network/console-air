#!/bin/bash

if [[ "$CI" != "true" ]]; then
    npm run generate -w packages/net
    git add ./packages/net/src/generated

    if git diff --cached --name-only | grep -qE '(^|/)package\.json$'; then
        echo ""
        echo "package.json changed — regenerating package-lock.json from scratch"
        echo "to preserve cross-platform optional deps (rolldown, sharp, etc.)."
        echo ""
        rm -f package-lock.json
        npm install --package-lock-only --ignore-scripts --silent
        git add package-lock.json
    fi

    echo ""
    echo "Checking if package-lock.json and package.json are in sync..."
    echo ""
    npm ci --dry-run --ignore-scripts > /dev/null
fi
