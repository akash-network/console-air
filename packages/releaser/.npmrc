# Installed in isolation (this package is excluded from the root workspace) so the
# modern conventional-recommended-bump@11 stack resolves its peer
# conventional-commits-parser@^6 correctly. The root .npmrc sets
# legacy-peer-deps=true (which leaves that peer unsatisfied and falls back to the
# commitlint-hoisted parser@5), so disable it here.
legacy-peer-deps=false
